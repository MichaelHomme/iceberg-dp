# Azure context
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=icberg-dev-rg

# Terraform backend bootstrap
TFSTATE_RESOURCE_GROUP=icberg-tfstate-rg
TFSTATE_STORAGE_ACCOUNT=icbergtfstate001
TFSTATE_CONTAINER=tfstate
TFSTATE_KEY=infrastructure/dev.tfstate

# Terraform workload config
TF_VAR_subscription_id=${AZURE_SUBSCRIPTION_ID}
TF_VAR_location=${AZURE_LOCATION}
TF_VAR_resource_group_name=${AZURE_RESOURCE_GROUP}
TF_VAR_environment=dev
TF_VAR_aks_name=icberg-dev-aks
TF_VAR_acr_name=icbergdevacr001
TF_VAR_key_vault_name=icberg-dev-kv-001
TF_VAR_data_storage_account_name=icbergdevdata001
TF_VAR_private_cluster_enabled=false
