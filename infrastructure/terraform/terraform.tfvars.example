subscription_id           = "00000000-0000-0000-0000-000000000000"
location                  = "eastus"
resource_group_name       = "rg-frigg-dev"
environment               = "dev"

vnet_cidr                 = "10.20.0.0/16"
aks_subnet_cidr           = "10.20.1.0/24"
user_vm_subnet_cidr       = "10.20.2.0/24"

aks_name                  = "frigg-dev-aks"
kubernetes_version        = null
node_pool_name            = "system"
node_vm_size              = "Standard_D4s_v5"
node_count_min            = 2
node_count_max            = 6
private_cluster_enabled   = false
oidc_issuer_enabled       = true
workload_identity_enabled = true

workload_identity_namespace   = "frigg-pot-platform"
polaris_identity_name         = "frigg-dev-polaris-mi"
trino_identity_name           = "frigg-dev-trino-mi"
airflow_identity_name         = "frigg-dev-airflow-mi"
polaris_service_account_name  = "polaris-sa"
trino_service_account_name    = "trino-sa"
airflow_service_account_name  = "airflow-sa"
polaris_storage_blob_role_enabled = true
trino_storage_blob_role_enabled   = true
airflow_storage_blob_role_enabled = false
polaris_storage_blob_role         = "Storage Blob Data Contributor"
trino_storage_blob_role           = "Storage Blob Data Contributor"
airflow_storage_blob_role         = "Storage Blob Data Reader"

acr_name                  = "friggdevacr001"
key_vault_name            = "frigg-dev-kv-001"
data_storage_account_name = "friggdevdata001"

tags = {
  project = "frigg-dp"
  owner   = "platform"
}
