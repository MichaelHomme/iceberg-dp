K8S_CONTEXT=
AKS_RESOURCE_GROUP=
AKS_NAME=
LETSENCRYPT_EMAIL=
INGRESS_NAMESPACE=ingress-nginx
INGRESS_RELEASE_NAME=ingress-nginx
INGRESS_CLASS_NAME=nginx
CERT_MANAGER_NAMESPACE=cert-manager
CERT_MANAGER_RELEASE_NAME=cert-manager
CERT_MANAGER_CLUSTER_ISSUER_NAME=letsencrypt-prod
PLATFORM_NAMESPACE=frigg-pot-platform
HELM_RELEASE_NAME=apache-platform
HELM_CHART_PATH=platform-engineering/helm/apache-platform

# Polaris Azure Blob (ADLS Gen2)
POLARIS_AZURE_ENABLED=false
POLARIS_AZURE_CREDENTIALS_SECRET_NAME=polaris-azure-credentials
POLARIS_AZURE_TENANT_ID=
POLARIS_AZURE_CLIENT_ID=
POLARIS_AZURE_CLIENT_SECRET=
POLARIS_CATALOG_DEFAULT_BASE_LOCATION=
POLARIS_BOOTSTRAP_CREDENTIALS=
POLARIS_OIDC_ENABLED=false
POLARIS_AUTHENTICATION_TYPE=mixed
POLARIS_OIDC_AUTH_SERVER_URL=
POLARIS_OIDC_CLIENT_ID=trino
POLARIS_OIDC_APPLICATION_TYPE=service
# Optional: set to `none` only when Keycloak HTTPS cert chain is not trusted by Polaris.
POLARIS_OIDC_TLS_VERIFICATION=
POLARIS_OIDC_PRINCIPAL_ID_CLAIM_PATH=
POLARIS_OIDC_PRINCIPAL_NAME_CLAIM_PATH=email
POLARIS_OIDC_ROLE_CLAIM_PATH=realm_access/roles
POLARIS_OIDC_ROLE_FILTER='^POLARIS_.*$'
POLARIS_OIDC_ROLE_MAPPING_REGEX='^POLARIS_(.*)$'
POLARIS_OIDC_ROLE_MAPPING_REPLACEMENT='PRINCIPAL_ROLE:$1'

# Trino OIDC
TRINO_OIDC_ENABLED=false
TRINO_OIDC_ISSUER=http://keycloak.frigg-pot-platform.svc.cluster.local/realms/frigg-data-platform
TRINO_OIDC_CLIENT_ID=trino
TRINO_OIDC_SCOPES=openid,email,profile
TRINO_OIDC_PRINCIPAL_FIELD=email
# For in-cluster dev without TLS ingress, this should be true for browser OIDC login.
TRINO_OIDC_ALLOW_INSECURE_OVER_HTTP=true
TRINO_WEB_UI_AUTHENTICATION_TYPE=oauth2
TRINO_OIDC_CREATE_SECRET=false
TRINO_OIDC_CLIENT_SECRET=
TRINO_OIDC_SECRET_NAME=trino-oidc-secret
TRINO_OIDC_SECRET_KEY=client-secret
TRINO_INTERNAL_COMMUNICATION_CREATE_SECRET=false
TRINO_INTERNAL_COMMUNICATION_SHARED_SECRET=
TRINO_INTERNAL_COMMUNICATION_SECRET_NAME=trino-internal-communication-secret
TRINO_INTERNAL_COMMUNICATION_SECRET_KEY=shared-secret
TRINO_INGRESS_ENABLED=false
TRINO_INGRESS_CLASS_NAME=nginx
TRINO_INGRESS_HOST=trino.example.com
TRINO_INGRESS_TLS_ENABLED=true
TRINO_INGRESS_TLS_SECRET_NAME=trino-tls
TRINO_INGRESS_CERT_MANAGER_CLUSTER_ISSUER=

# Phase 1 Keycloak (dev/in-cluster)
KEYCLOAK_NAMESPACE=frigg-pot-platform
KEYCLOAK_RELEASE_NAME=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=trino
# Bitnami images are served from bitnamilegacy on Docker Hub
KEYCLOAK_IMAGE_REGISTRY=docker.io
KEYCLOAK_IMAGE_REPOSITORY=bitnamilegacy/keycloak
KEYCLOAK_POSTGRESQL_IMAGE_REGISTRY=docker.io
KEYCLOAK_POSTGRESQL_IMAGE_REPOSITORY=bitnamilegacy/postgresql
# Leave empty to use chart defaults (latest compatible images)
KEYCLOAK_IMAGE_TAG=
KEYCLOAK_POSTGRESQL_IMAGE_TAG=
KEYCLOAK_HELM_TIMEOUT=20m
KEYCLOAK_REALM=frigg-data-platform
KEYCLOAK_CLIENT_SECRET=

# Test users for Phase 1 bootstrap
ADMIN_USER_EMAIL=michael.homme@fb.no
ADMIN_USER_PASSWORD=
ENGINEER_USER_EMAIL=alexander.field@fb.no
ENGINEER_USER_PASSWORD=
ANALYST_USER_EMAIL=olav.syse@fb.no
ANALYST_USER_PASSWORD=
